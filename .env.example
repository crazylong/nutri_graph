# nutri_graph 环境变量模板
# 复制为 .env 并填入真实值。本地 docker-compose 起服务时，大部分默认值即可用。
# 与 config.py 的 os.getenv(...) 一一对应，此处全部列出；留空的项必须自行填写。

# ============================================================
# Server
# ============================================================
HOST=0.0.0.0
PORT=8810
DEBUG=false

# ============================================================
# Neo4j 图谱
# ============================================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=nutrigraph-dev

# ============================================================
# Milvus 向量库
# ============================================================
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
# 集合名带模型版本后缀，避免 embedding 维度漂移
MILVUS_ENTITY_COLLECTION=kg_entity
MILVUS_CHUNK_COLLECTION=kb_chunks

# ============================================================
# PostgreSQL（候选表 + 记忆 + pgvector）
# ============================================================
PG_DSN=postgresql://nutri:nutri@localhost:5432/nutri_graph
PGVECTOR_DIM=1024

# ============================================================
# DashScope（LLM + Embedding）—— 密钥必填
# ============================================================
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
# 推理模型会把预算先花在 reasoning 上，content 为空时放大到该上限重试一次
LLM_MAX_TOKENS_CEILING=8192
LLM_TIMEOUT=90.0

# ---- 大语言模型池（必填，代码里不写死任何模型名）----
# 只收「模型类型 = 大语言模型」的模型，顺序即优先级（排第一的是主模型）。
# 额度多少 / 什么时候到期不用写：额度用尽的模型会被**移出池**，其它错误只进冷却队列。
# 视觉/视频模型（qwen-image-*、wan*-video）协议不兼容，不要放进来。
LLM_MODEL_POOL=deepseek-v4-flash-0731,qwen3.8-max,qwen3.8-2.4t-a95b,deepseek-v4-pro-0813

# 兜底模型：池内模型全部不可用（额度用尽被移除 / 都在冷却）时才用。
# 填一个池外的模型最合适 —— 池内四个一起没额度时，它多半还有。
LLM_MODEL=deepseek-v4.1-flash-1017

# ---- 模型池行为参数 ----
# 额度/冷却状态的持久化位置：重启后不会再撞已经移出池的模型
LLM_POOL_STATE_PATH=data/llm_pool_state.json
# 限流/抖动 → 短冷却后允许重试
LLM_RATE_LIMIT_COOLDOWN_S=60
# 模型不存在/无权限 → 冷却多少小时再试
LLM_INVALID_COOLDOWN_H=24
# 额度用尽不冷却：直接从 LLM_MODEL_POOL 移除；
# 百炼补了额度后跑 `python -m scripts.check_llm_pool --reset` 让它回池。

# ============================================================
# 检索配置
# ============================================================
ENTITY_LINK_THRESHOLD=0.82
ENTITY_LINK_TOP_K=5
CHUNK_TOP_K=6
CHUNK_THRESHOLD=0.40
GRAPH_MAX_RESULTS=8

# ============================================================
# 证据策略（strict / balanced / all）
# ============================================================
DEFAULT_EVIDENCE_POLICY=balanced
# 各意图默认允许的 evidence_type（逗号分隔）
EVIDENCE_PAIR=guideline,measured,traditional
EVIDENCE_CONTRA_POP=guideline,measured
EVIDENCE_CONTRA_ITEM=guideline,measured
EVIDENCE_NUTRITION=guideline,measured
EVIDENCE_SUBSTITUTE=guideline,measured,traditional

# ============================================================
# Langfuse（自托管）
# ============================================================
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# ============================================================
# 记忆（PostgreSQL）
# ============================================================
MEMORY_ENABLED=true
SHORT_TERM_WINDOW=10
SESSION_SUMMARY_THRESHOLD=30
MEMORY_FACT_TOP_K=4

# ============================================================
# 安全 / 边界控制
# ============================================================
# 红旗症状：命中即拦截，绕过图谱直接建议就医。逗号分隔，可自由增删
RED_FLAG_SYMPTOMS=胸痛,呼吸困难,意识模糊,意识改变,持续高热,剧烈腹痛,大出血,便血,呕血,抽搐,昏迷,孕产急症,心梗,中风
# 免责声明（随每次回答输出）
DISCLAIMER=本回答由食疗知识图谱辅助生成，仅供健康科普参考，不能替代医生诊断与用药指导。如有不适请及时就医。

# ============================================================
# 身份与访问控制（needs 13）
# ============================================================
# true = /chat 等业务接口必须带 access token；false = 开发期允许匿名
AUTH_REQUIRED=false

# JWT 签名密钥：不填会退化成进程内临时密钥（重启即全员登出），生产必须配置
# 生成：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALG=HS256
JWT_ISSUER=nutri_graph
ACCESS_TTL_S=1800
REFRESH_TTL_D=7

# 手机号存储：PHONE_ENC_KEY 用 Fernet 生成（44 字符 urlsafe base64）
# 生成：python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# PHONE_HASH_PEPPER 一旦上线就不要改 —— 改了所有已注册手机号都查不到
PHONE_ENC_KEY=
PHONE_HASH_PEPPER=

# ============================================================
# 短信通道（needs 13）
# ============================================================
# console = 本地开发，不发真短信，验证码打日志（DEBUG=true 时响应里回填 dev_code）
# dypns   = 阿里云「短信认证」（号码认证服务），个人认证账号免资质/免签名/免模板
#
# 不要用「短信服务 SMS」：个人认证账号的自用签名过不了运营商实名制报备，
# 且官方已停止受理「测试或学习 / 已备案网站 / 公众号或小程序」等签名来源。
#
# 生产填 dypns，并先补齐下面「dypns 专用」四项；缺任一项登录页发不出验证码
# （/auth/sms 返回 503，启动日志会列出缺哪些）。开通步骤：docs/sms-dypns-setup.md
SMS_PROVIDER=dypns

# ---- dypns 专用 ----
# AK 建议用 RAM 子账号，只授 dypns:SendSmsVerifyCode / dypns:CheckSmsVerifyCode
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
# 以下三项从号码认证控制台「赠送签名 / 赠送模板」页面复制，不可自定义
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
SMS_SCHEME_NAME=
SMS_TEMPLATE_PARAM={"code":"##code##","min":"5"}
# 联调时可临时设 true 让接口回传验证码，生产必须 false
SMS_RETURN_VERIFY_CODE=false

# ---- 验证码策略 ----
SMS_CODE_LENGTH=6
SMS_VALID_TIME_S=300
SMS_INTERVAL_S=60

# ---- 频控（平台不代管刷单，这些是唯一防线）----
SMS_MAX_PER_PHONE_HOUR=5
SMS_MAX_PER_PHONE_DAY=10
SMS_MAX_PER_IP_HOUR=10
SMS_MAX_PER_DEVICE_DAY=10
SMS_MAX_GLOBAL_DAY=200
SMS_MAX_VERIFY_FAILS=5
# IP 维度的失败阈值要远高于手机号：NAT 后面是大量正常用户共用出口 IP，
# 按 5 次锁会把整栋楼的人一起锁死。50 次只用于识别批量爆破。
SMS_MAX_VERIFY_FAILS_PER_IP=50

# ---- 图形验证码（防刷短信）----
CAPTCHA_FREE_SENDS_PER_IP=1
CAPTCHA_TTL_S=300
CAPTCHA_MAX_ATTEMPTS=5
SMS_LOCK_MINUTES=15

# ============================================================
# 未收录食材补录（Phase 9）
# ============================================================
# 未收录登记总开关 / 限流
FOOD_REQUEST_ENABLED=true
FOOD_REQUEST_DAILY_LIMIT_PER_USER=10
FOOD_REQUEST_GLOBAL_DAILY_LIMIT=200
FOOD_NEAR_MISS_MIN_SIM=0.62

# 抓取画像：auto=内置优先再调模型（离线可用）| llm | static
FOOD_DRAFT_MODE=auto

# USDA FoodData Central（免费 key 去 api.data.gov 领，1000 次/小时）
# DEMO_KEY 只有 30 次/小时、50 次/天且全站共享，只够验证链路
FDC_API_KEY=DEMO_KEY
FDC_TIMEOUT=20.0
FDC_BASE_URL=https://api.nal.usda.gov/fdc/v1
FDC_DATA_TYPES=Foundation,SR Legacy
FOOD_FETCH_DAILY_BUDGET=50

# 自动通过门槛：单源一致性封顶 0.6 → 得分最高 0.88，所以现在一律进人工
FOOD_AUTO_APPROVE_MIN_SCORE=0.9
FOOD_AUTO_APPROVE_MIN_SOURCES=2

# ---- 审核闭环与可信度分层（Phase 9.3）----
# 几个来源才算「交叉验证过」；少于这个数 → 标 provisional
FOOD_TRUSTED_MIN_SOURCES=2
# 证据等级：单源封 C，多源才给 B（A 只留给指南与临床共识）
PROVISIONAL_EVIDENCE_LEVEL=C
TRUSTED_EVIDENCE_LEVEL=B
# 检索是否包含单源数据：
#   true  = 刚补录完就能查到（否则用户以为没收录，会重复登记）
#   false = 严格模式，只答交叉验证过的硬证据
# 两种模式下上下文都会显式标注「单源」，不会混成硬证据
INCLUDE_PROVISIONAL=true

# ============================================================
# 日志
# ============================================================
# 日志目录：不填默认用项目根目录下的 logs/（绝对路径，不随启动目录漂移）
# LOG_DIR=/opt/code/nutri_graph/logs
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# 轮转周期：midnight = 每天零点切新文件；也支持 S/M/H/D/W0-W6（见 TimedRotatingFileHandler）
LOG_WHEN=midnight
# 轮转间隔：配合 LOG_WHEN，如 WHEN=H、INTERVAL=6 表示每 6 小时切一次
LOG_INTERVAL=1
# 历史日志保留天数（backupCount），超出的自动删除
LOG_RETENTION_DAYS=14
